# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key. Secret. Server-only.
GEMINI_API_KEY=your-gemini-key
# Optional: which Gemini model to use. "gemini-flash-latest" always points to the current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional: lighter backup model used automatically when the main one is overloaded.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Your site URL (used for login redirects). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: daily AI limits per user (protects the shared free quota)
DAILY_LIMIT_PROCESS=6
DAILY_LIMIT_GENERATE=15
DAILY_LIMIT_GRADE=40
